{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "types": ["node"], "skipLibCheck": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"]
}
